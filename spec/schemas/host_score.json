{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HostScore",
  "type": "object",
  "required": [
    "hostId",
    "score",
    "grade",
    "findingsDigest"
  ],
  "properties": {
    "hostId": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "serverEndpoint": {
      "type": "string"
    },
    "score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "grade": {
      "type": "string",
      "enum": ["A", "B", "C", "D", "F"]
    },
    "findingsDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false
}
