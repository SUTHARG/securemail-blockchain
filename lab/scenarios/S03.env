SCENARIO=S03
smtpd_tls_security_level=may
smtpd_tls_protocols=!SSLv2,!SSLv3,!TLSv1,!TLSv1.1,!TLSv1.3
smtpd_tls_mandatory_protocols=!SSLv2,!SSLv3,!TLSv1,!TLSv1.1,!TLSv1.3
smtpd_tls_ciphers=medium
smtpd_tls_mandatory_ciphers=medium
tls_medium_cipherlist=ECDHE-RSA-DES-CBC3-SHA:DES-CBC3-SHA
smtpd_tls_cert_file=/ca/out/valid-2048-sha256.crt
smtpd_tls_key_file=/ca/out/valid-2048-sha256.key
smtpd_sasl_auth_enable=no
smtpd_tls_auth_only=no
